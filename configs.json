{
  "_comment": "统一策略配置。支持 Pandas/Polars 共用；Polars 版本会按 alias 展示策略名。",
  "_comment_fields": "activate 控制是否启用；params 为策略参数字典；可追加自定义 _comment 字段做说明。",
  "default_strategies": [
    "B1战法",
    "B1战法（V2）"
  ],
  "selectors": [
    {
      "class": "BBIKDJSelector",
      "alias": "B1战法",
      "activate": true,
      "_comment": "核心思路：BBI 上行 + KDJ 低位 + 趋势过滤。",
      "params": {
        "j_threshold": 15,
        "bbi_min_window": 20,
        "max_window": 120,
        "price_range_pct": 1,
        "bbi_q_threshold": 0.2,
        "j_q_threshold": 0.10
      }
    },
    {
      "class": "SuperB1Selector",
      "alias": "SuperB1战法",
      "activate": true,
      "_comment": "在B1战法基础上增加末日跌幅和形态过滤，更偏短线反转。",
      "params": {
        "lookback_n": 10,
        "close_vol_pct": 0.02,
        "price_drop_pct": 0.02,
        "j_threshold": 10,
        "j_q_threshold": 0.10,
        "B1_params": { 
          "j_threshold": 15,
          "bbi_min_window": 20,
          "max_window": 120,
          "price_range_pct": 1,
          "bbi_q_threshold": 0.3,
          "j_q_threshold": 0.10
        }
      }
    },
    {
      "class": "BBIShortLongSelector",
      "alias": "补票战法",
      "activate": true,
      "_comment": "RSV 短长周期配合 + BBI 斜率过滤。",
      "params": {
        "n_short": 5,
        "n_long": 21,
        "m": 5,
        "bbi_min_window": 2,
        "max_window": 120,
        "bbi_q_threshold": 0.2,
        "upper_rsv_threshold": 75,
        "lower_rsv_threshold":25
      }
    }, 
    {
      "class": "PeakKDJSelector",        
      "alias": "填坑战法",
      "activate": true,
      "_comment": "先识别峰值回撤，再结合 KDJ 做低位筛选。",                
      "params": {
        "j_threshold": 10,                 
        "max_window": 120,                
        "fluc_threshold": 0.03,
        "j_q_threshold": 0.10,
        "gap_threshold": 0.2
      }
    },
    {
      "class": "MA60CrossVolumeWaveSelector",
      "alias": "上穿60放量战法",
      "activate": true,
      "_comment": "MA60 有效上穿 + 放量 + 低位动量。",
      "params": {
        "lookback_n": 25,
        "vol_multiple": 1.8,
        "j_threshold": 15,
        "j_q_threshold": 0.10,
        "ma60_slope_days": 5,
        "max_window": 120        
      }
    },
    {
      "class": "ZXDKXBalanceSelector",
      "alias": "多空平衡选股策略",
      "activate": true,
      "_comment": "条件：|长期多空线-短期趋势线| 小于黏合阈值；当日成交量为最近一周新低；收盘价不低于 长期多空线 * 偏离阈值。",
      "params": {
        "zx_stick_limit_threshold": 0.04,
        "close_vs_long_term_bull_bear_line_limit_threshold": 0.95,
        "recent_volume_window": 5
      }
    },
    {
      "class": "PerfectB1Selector",
      "alias": "B1战法（V2）",
      "activate": true,
      "_comment": "J<13；振幅<7%；涨幅在(-2%,2%)；收盘价大于MA60和长期多空线；20日内存在上涨倍量柱；且长期多空线<短期趋势线。",
      "params": {
        "j_threshold": 13,
        "amplitude_limit": 0.07,
        "pct_chg_upper": 0.02,
        "pct_chg_lower": -0.02,
        "ma_window": 60,
        "volume_spike_lookback": 20,
        "volume_spike_multiple": 1.8
      }
    },
    {
      "class": "PerfectB1Selector",
      "alias": "完美B1",
      "activate": true,
      "_comment": "基于B1战法（V2）追加条件：最近5个交易日内至少4个交易日缩量，且选股当日成交量为最近5日新低。",
      "params": {
        "j_threshold": 13,
        "amplitude_limit": 0.07,
        "pct_chg_upper": 0.02,
        "pct_chg_lower": -0.02,
        "ma_window": 60,
        "volume_spike_lookback": 20,
        "volume_spike_multiple": 1.8,
        "volume_step_down_window": 5,
        "min_volume_step_down_days": 4,
        "recent_volume_new_low_window": 5
      }
    },
    {
      "class": "BigBullishVolumeSelector",
      "alias": "暴力K战法",
      "activate": true,
      "_comment": "大阳线 + 放量 + 价格位置约束（避免追高）。",
      "params": {
        "up_pct_threshold": 0.06,
        "upper_wick_pct_max": 0.02,            
        "require_bullish_close": true,
        "close_lt_short_term_trend_line_mult": 1.15,
        "vol_lookback_n": 20,
        "vol_multiple": 2.5
      }
    }
  ]
}
